# ─── Build outputs ────────────────────────────────────────────
# Cargo
/target/
**/target/
**/*.rs.bk
**/*.pdb
*.profraw

# Node / Vite
node_modules/
apps/codex-assistant-manager/dist/

# Root workspace lockfile — root package.json only forwards scripts to
# apps/*; npm regenerates this whenever a root-level script runs.
# Per-app lockfiles under apps/*/package-lock.json are still committed.
/package-lock.json

# Tauri (generated at build time)
apps/codex-assistant-manager/src-tauri/gen/

# Installer packaging output (scripts/installer/macos/package-dmg.sh writes here)
/dist/

# Installer bundle artifacts (in case they're produced outside /dist/)
*.msi
*.msix
*.appx
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.snap

# ─── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Secrets / local env ──────────────────────────────────────
.env
.env.*
!.env.example

# ─── Secrets / credentials ────────────────────────────────────
# Defense in depth: even though we don't commit these, refuse them at the
# staging layer so a stray file in the working tree never reaches a remote.
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
.npmrc
.netrc
credentials.json
service_account*.json
*.sqlite
*.db

# ─── Editor / IDE ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.iml

# ─── OS metadata ──────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.stackdump

# ─── Frontend tooling caches ──────────────────────────────────
.vite/
.eslintcache
*.tsbuildinfo

# ─── Test coverage ────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Tauri per-app target (defensive; workspace target is root) ─
apps/codex-assistant-manager/src-tauri/target/

# ─── Local tooling state ──────────────────────────────────────
.claude/
.omx/

# ─── Cargo per-machine config & home ──────────────────────────
# .cargo/config.toml is commonly used as a per-machine workaround (e.g.
# crates.io git-protocol fallback for restricted networks). .cargo-home/ is
# a project-scoped CARGO_HOME used when developers redirect cargo's cache
# into the repo. Neither is portable across environments.
.cargo/
.cargo-home/

# ─── Misc local junk ──────────────────────────────────────────
*.pid
*.seed
*.pid.lock
